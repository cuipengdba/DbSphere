{
  "uid": "dbsphere-container-rca",
  "title": "DbSphere · PostgreSQL 存储等待与根因",
  "tags": [
    "dbsphere",
    "dbsphere-storage"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "在 DbSphere 查看相同事件和时段",
      "url": "/grafana/dbsphere-return?view=storage&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}",
      "targetBlank": false,
      "type": "link"
    },
    {
      "title": "回到原事件",
      "type": "link",
      "url": "/grafana/dbsphere-return?view=event&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}"
    },
    {
      "title": "DbSphere 专题",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "dbsphere-storage"
      ],
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "asset",
        "label": "资产 ID",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "container",
        "label": "容器",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "event",
        "label": "事件 ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "数据库 I/O 等待与重读",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dbsphere-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "在 DbSphere 查看相同事件和时段",
              "url": "/grafana/dbsphere-return?view=storage&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}",
              "targetBlank": false
            }
          ],
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbsphere_container_pg_io_wait_sessions{asset_id=~\"${asset:raw}\"}",
          "legendFormat": "I/O 等待 {{pod}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "dbsphere_container_refault_per_second{asset_id=~\"${asset:raw}\",container=~\"${container:raw}\",device=\"\"}",
          "legendFormat": "页面重读 {{container}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "WAL 与临时文件生成",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dbsphere-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "在 DbSphere 查看相同事件和时段",
              "url": "/grafana/dbsphere-return?view=storage&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}",
              "targetBlank": false
            }
          ],
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dbsphere_container_pg_wal_bytes_total{asset_id=~\"${asset:raw}\"}[$__rate_interval])",
          "legendFormat": "WAL {{pod}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "rate(dbsphere_container_pg_temp_bytes_total{asset_id=~\"${asset:raw}\"}[$__rate_interval])",
          "legendFormat": "临时文件 {{pod}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "数据库读写及检查点计时",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dbsphere-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "在 DbSphere 查看相同事件和时段",
              "url": "/grafana/dbsphere-return?view=storage&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}",
              "targetBlank": false
            }
          ],
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(dbsphere_container_pg_read_time_seconds_total{asset_id=~\"${asset:raw}\"}[$__rate_interval])",
          "legendFormat": "PG 读计时",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "rate(dbsphere_container_pg_write_time_seconds_total{asset_id=~\"${asset:raw}\"}[$__rate_interval])",
          "legendFormat": "PG 写计时",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "rate(dbsphere_container_pg_checkpoint_sync_seconds_total{asset_id=~\"${asset:raw}\"}[$__rate_interval])",
          "legendFormat": "检查点同步",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "容器读写与底层设备",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dbsphere-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "在 DbSphere 查看相同事件和时段",
              "url": "/grafana/dbsphere-return?view=storage&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}",
              "targetBlank": false
            }
          ],
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbsphere_container_read_bytes_per_second{asset_id=~\"${asset:raw}\",container=~\"${container:raw}\",device=\"\"}",
          "legendFormat": "容器读 {{container}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "dbsphere_container_write_bytes_per_second{asset_id=~\"${asset:raw}\",container=~\"${container:raw}\",device=\"\"}",
          "legendFormat": "容器写 {{container}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "dbsphere_container_node_read_bytes_per_second{asset_id=~\"${asset:raw}\"}",
          "legendFormat": "节点读 {{device}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        }
      ]
    }
  ]
}
