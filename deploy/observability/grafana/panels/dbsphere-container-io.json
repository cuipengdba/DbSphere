{
  "uid": "dbsphere-container-io",
  "title": "DbSphere · 容器磁盘 I/O",
  "tags": [
    "dbsphere",
    "dbsphere-storage"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "15s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "在 DbSphere 查看相同事件和时段",
      "url": "/grafana/dbsphere-return?view=storage&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}&device=${device:percentencode}",
      "targetBlank": false,
      "type": "link"
    },
    {
      "title": "回到原事件",
      "type": "link",
      "url": "/grafana/dbsphere-return?view=event&source=storage&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}&device=${device:percentencode}"
    },
    {
      "title": "DbSphere 专题",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "dbsphere-storage"
      ],
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "asset",
        "label": "资产 ID",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "container",
        "label": "容器",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "device",
        "label": "设备号",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "event",
        "label": "事件 ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "读写吞吐",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "dbsphere-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "links": [
            {
              "title": "在 DbSphere 查看相同事件和时段",
              "url": "/grafana/dbsphere-return?view=storage&asset=${asset:percentencode}&container=${container:percentencode}&event=${event:percentencode}&from=${__from:date:iso}&to=${__to:date:iso}&device=${device:percentencode}",
              "targetBlank": false
            }
          ],
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbsphere_container_read_bytes_per_second{asset_id=~\"${asset:raw}\",container=~\"${container:raw}\",device=\"\"}",
          "legendFormat": "读 {{container}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "dbsphere_container_write_bytes_per_second{asset_id=~\"${asset:raw}\",container=~\"${container:raw}\",device=\"\"}",
          "legendFormat": "写 {{container}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          }
        }
      ]
    },
