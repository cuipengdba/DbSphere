{
  "uid": "dbsphere-etcd",
  "title": "DbSphere · etcd 控制面",
  "description": "etcd 成员的 Leader 状态、提案、WAL、存储与 Kubernetes API Server 同窗指标。",
  "tags": [
    "DbSphere",
    "etcd",
    "Kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "返回 DbSphere 实时观测",
      "type": "link",
      "url": "/grafana/dbsphere-return?view=live&asset=${asset}&from=${__from:date:iso}&to=${__to:date:iso}",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "回到原事件",
      "type": "link",
      "url": "/grafana/dbsphere-return?view=event&event=${event}&asset=${asset}&from=${__from:date:iso}&to=${__to:date:iso}&context=${dbsphere_context:percentencode}",
      "icon": "bolt",
      "targetBlank": false
    },
    {
      "title": "DbSphere 专题",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "dbsphere"
      ],
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "organization",
        "label": "组织 ID",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "cluster",
        "label": "集群",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "asset",
        "label": "资产 ID",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "engine",
        "label": "引擎",
        "type": "textbox",
        "query": "etcd",
        "current": {
          "text": "etcd",
          "value": "etcd"
        },
        "hide": 2,
        "skipUrlSync": false
      },
      {
        "name": "event",
        "label": "事件 ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 2,
        "skipUrlSync": false
      },
      {
        "name": "dbsphere_context",
        "label": "调查上下文",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 2,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "etcd 观测端点",
      "description": "当前纳管的观测端点。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "dbsphere-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(dbsphere_asset_info{asset_id=~\"$asset\", organization_id=~\"$organization\", cluster=~\"$cluster\", engine=\"etcd\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "dbsphere-prometheus"
          },
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#008985",
                "value": null
              }
            ]
          },
          "links": [
            {
              "title": "核对 DbSphere 原事件",
              "url": "/grafana/dbsphere-return?view=event&event=${event}&asset=${asset}&from=${__from:date:iso}&to=${__to:date:iso}&context=${dbsphere_context:percentencode}",
              "targetBlank": false
            }
          ],
          "noValue": "暂无样本"
