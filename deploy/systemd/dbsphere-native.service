[Unit]
Description=DbSphere database operations and monitoring
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/etc/dbsphere-native/dbsphere.env
ExecStart=/opt/dbsphere-native/dbsphere
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
