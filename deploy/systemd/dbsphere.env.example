# Use an existing dedicated, writable PostgreSQL 18 database.
DBSPHERE_DATABASE_URL=postgres://dbsphere:REPLACE@pg18.example.internal:5432/dbsphere?sslmode=verify-full
DBSPHERE_ADMIN_PASSWORD=REPLACE_WITH_FIRST_START_PASSWORD
# Generate a 32-byte base64 key for a new database. Preserve the existing key on migration.
DBSPHERE_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
DBSPHERE_HOST=127.0.0.1
DBSPHERE_PORT=8081
DBSPHERE_ENABLE_GO_COLLECTOR=true
DBSPHERE_COOKIE_SECURE=false
