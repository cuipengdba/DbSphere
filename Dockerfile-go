FROM --platform=$BUILDPLATFORM golang:1.27.4-bookworm AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY package.json ./
COPY assets.go ./
COPY public ./public
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags='-s -w' -o /out/dbsphere ./cmd/dbsphere

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/dbsphere /dbsphere
COPY LICENSE /licenses/DBSphere-LICENSE
COPY third_party/licenses/go /licenses/go
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --retries=12 CMD ["/dbsphere", "healthcheck"]
ENTRYPOINT ["/dbsphere"]
